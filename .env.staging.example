# Staging must use a separate BotFather token. Never copy the production token here.
TG_API_KEY=replace-with-staging-bot-token
ASSEMBLI_AI=
POSTGRES_DSN=postgresql:///floorball_bot_staging?host=/var/run/postgresql
PUBLISH_ENABLED=false
FLOORBALL_SITE_REPO=/home/moses/floorball.kz
MEDIA_ROOT=./var/staging/media
WORKTREE_ROOT=./var/staging/worktrees
BACKUP_ROOT=./var/staging/backups
RUN_EXTERNAL_TESTS=false
LOG_LEVEL=INFO
