# Secrets: copy to .env for local development; never commit real values.
TG_API_KEY=
# The user-provided name is intentionally supported.
ASSEMBLI_AI=
# Optional canonical alias; ASSEMBLI_AI wins when both are set.
ASSEMBLYAI_API_KEY=

POSTGRES_DSN=postgresql://floorballbot:change-me@127.0.0.1:5432/floorball_bot
# libpq variables used by pg_dump/restore scripts; keep password in PGPASSFILE.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=floorball_bot
PGUSER=floorballbot
PGPASSFILE=/etc/floorball-bot.pgpass
FLOORBALL_SITE_REPO=/home/moses/floorball.kz
MEDIA_ROOT=./var/media
WORKTREE_ROOT=./var/worktrees
BACKUP_ROOT=./var/backups
# Antigravity CLI must be authenticated for the Linux user running the worker.
AGY_CLI=agy
AGY_MODEL=gemini-3.8-flash-high
AGY_EFFORT=high
AGY_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO
RUN_EXTERNAL_TESTS=false
# Fail closed outside production. Set true only for the approved production worker.
PUBLISH_ENABLED=false

# Generated Plesk webhooks are private credentials. Optional for local previews.
PLESK_STATIC_WEBHOOK_URL=
PLESK_SOURCE_WEBHOOK_URL=

# Telegram Mini App. Public URL must be stable HTTPS and point to MINI_APP_HOST:PORT.
MINI_APP_PUBLIC_URL=https://example.ts.net/floorball-miniapp/
# tailscale keeps a stable URL across reboots; cloudflare uses a changing Quick Tunnel URL.
MINI_APP_TUNNEL_PROVIDER=tailscale
MINI_APP_HOST=127.0.0.1
MINI_APP_PORT=8092
MINI_APP_AUTH_MAX_AGE_SECONDS=86400
MINI_APP_DIST_ROOT=./miniapp/dist
