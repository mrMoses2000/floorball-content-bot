[Unit]
Description=Floorball Content Bot health check
After=postgresql.service

[Service]
Type=oneshot
User=floorballbot
Group=floorballbot
WorkingDirectory=/opt/floorball-content-bot
EnvironmentFile=/etc/floorball-bot.env
ExecStart=/opt/floorball-content-bot/.venv/bin/floorball-bot health
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
SyslogIdentifier=floorball-health

