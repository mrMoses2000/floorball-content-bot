[Unit]
Description=Floorball Content Bot Telegram ingress
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=floorballbot
Group=floorballbot
WorkingDirectory=/opt/floorball-content-bot
EnvironmentFile=/etc/floorball-bot.env
ExecStart=/opt/floorball-content-bot/.venv/bin/floorball-bot bot
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/floorball-bot
MemoryMax=768M
SyslogIdentifier=floorball-bot

[Install]
WantedBy=multi-user.target
