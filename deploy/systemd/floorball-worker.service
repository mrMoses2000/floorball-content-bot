[Unit]
Description=Floorball Content Bot background worker
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=floorballbot
Group=floorballbot
WorkingDirectory=/opt/floorball-content-bot
EnvironmentFile=/etc/floorball-bot.env
ExecStart=/opt/floorball-content-bot/.venv/bin/floorball-bot worker
Restart=on-failure
RestartSec=10s
TimeoutStopSec=150s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/floorball-bot /srv/floorball/worktrees
MemoryMax=3G
TasksMax=128
SyslogIdentifier=floorball-worker

[Install]
WantedBy=multi-user.target
