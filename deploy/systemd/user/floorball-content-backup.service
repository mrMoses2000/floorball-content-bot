[Unit]
Description=Floorball content daily backup
After=postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/home/moses/tg_bot_floorball_site
EnvironmentFile=/home/moses/tg_bot_floorball_site/.env
Environment=PATH=/usr/lib/postgresql/18/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/moses/tg_bot_floorball_site/.venv/bin/python /home/moses/tg_bot_floorball_site/scripts/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/moses/tg_bot_floorball_site/var/backups
