[Unit]
Description=HTTPS tunnel for Floorball Mini App
After=network-online.target floorball-content-miniapp.service
Wants=network-online.target floorball-content-miniapp.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/moses/tg_bot_floorball_site
EnvironmentFile=/home/moses/tg_bot_floorball_site/.env
ExecStart=/home/moses/tg_bot_floorball_site/.venv/bin/python /home/moses/tg_bot_floorball_site/scripts/run_tunnel.py
Restart=always
RestartSec=8s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/moses/tg_bot_floorball_site
MemoryMax=256M
TasksMax=64
SyslogIdentifier=floorball-tunnel

[Install]
WantedBy=default.target
