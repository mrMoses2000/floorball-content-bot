[Unit]
Description=Floorball services watchdog and auto-recovery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/moses/tg_bot_floorball_site
ExecStart=/home/moses/tg_bot_floorball_site/scripts/watchdog.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/moses/tg_bot_floorball_site
